@echo off
title TDS Desk - Tally Bridge setup
color 0F
echo.
echo   ===========================================================
echo     TDS Desk - Tally Bridge setup
echo   ===========================================================
echo.
echo   This puts the Tally Bridge on this computer, starts it, and
echo   makes it start again every time you sign in.
echo.
echo   Nothing is installed into Windows and no admin rights are
echo   needed. To remove it later, run this file again and press R.
echo.
set "DEST=%LOCALAPPDATA%\TDS Desk Bridge"
set "STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "PORT=9100"
if /I "%~1"=="/remove" goto remove
choice /C IRQ /N /M "  Press I to install, R to remove, Q to quit: "
if errorlevel 3 goto done
if errorlevel 2 goto remove

echo.
echo   Installing to: %DEST%
if not exist "%DEST%" mkdir "%DEST%" >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p = '%~f0'; $all = Get-Content -LiteralPath $p; $mark = '::PS1' + 'BEGIN::'; $i = ($all | Select-String -SimpleMatch $mark | Select-Object -Last 1).LineNumber; $b64 = ($all[$i..($all.Count - 1)] | ForEach-Object { $_.TrimStart(':') }) -join ''; [IO.File]::WriteAllBytes((Join-Path $env:LOCALAPPDATA 'TDS Desk Bridge\TDSBridge.ps1'), [Convert]::FromBase64String($b64)); if ((Get-Item (Join-Path $env:LOCALAPPDATA 'TDS Desk Bridge\TDSBridge.ps1')).Length -lt 10000) { exit 1 }"
if errorlevel 1 (
  echo.
  echo   The bridge file could not be written. Copy this window and send it for help.
  pause
  goto done
)

rem  a starter that keeps the bridge running and starts it hidden at sign-in
> "%DEST%\run-hidden.vbs" echo Set sh = CreateObject("WScript.Shell")
>> "%DEST%\run-hidden.vbs" echo Do
>> "%DEST%\run-hidden.vbs" echo   sh.Run "powershell.exe -NoLogo -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File ""%DEST%\TDSBridge.ps1""", 0, True
>> "%DEST%\run-hidden.vbs" echo   WScript.Sleep 5000
>> "%DEST%\run-hidden.vbs" echo Loop
copy /Y "%DEST%\run-hidden.vbs" "%STARTUP%\TDS Desk Tally Bridge.vbs" >nul 2>&1

rem  a shortcut to show the bridge window when someone wants to look at it
> "%DEST%\Show bridge window.bat" echo @echo off
>> "%DEST%\Show bridge window.bat" echo title TDS Desk - Tally Bridge
>> "%DEST%\Show bridge window.bat" echo powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%DEST%\TDSBridge.ps1"
>> "%DEST%\Show bridge window.bat" echo pause

echo   Starting the bridge...
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process -Filter \"Name = 'powershell.exe'\" | Where-Object { $_.CommandLine -like '*TDSBridge.ps1*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }" >nul 2>&1

rem  way 1: the hidden starter that also restarts it
start "" wscript.exe "%DEST%\run-hidden.vbs"
call :waitfor 10
if not errorlevel 1 goto ready

rem  way 2: start PowerShell hidden directly (some servers block wscript)
echo   Trying another way to start it...
start "TDS Desk Tally Bridge" /MIN powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%DEST%\TDSBridge.ps1"
call :waitfor 10
if not errorlevel 1 goto ready
goto slow

:waitfor
set /A TRIES=0
:waitloop
set /A TRIES+=1
rem  a plain socket test, so proxies and firewall rules for web traffic do not confuse it
powershell -NoProfile -Command "try { $c = New-Object Net.Sockets.TcpClient; $c.Connect('127.0.0.1', %PORT%); $c.Close(); exit 0 } catch { exit 1 }" >nul 2>&1
if not errorlevel 1 exit /b 0
if %TRIES% GEQ %1 exit /b 1
ping -n 2 127.0.0.1 >nul
goto waitloop

:ready
echo.
echo   ===========================================================
echo     The Tally Bridge is running.
echo   ===========================================================
echo.
echo   Now do this once:
echo     1. Open TallyPrime and the company you work in.
echo        (F1 Help ^> Settings ^> Connectivity: "TallyPrime acts as" = Both)
echo     2. Open TDS Desk on THIS computer.
echo     3. Go to Settings ^> Tally Bridge and press Connect.
echo        It finds this bridge by itself - no key to copy.
echo.
echo   It starts again every time you sign in to Windows.
echo   Folder: %DEST%
echo.
pause
goto done

:slow
echo.
echo   The bridge did not answer. Checking what is in the way...
powershell -NoProfile -Command "$p = Get-NetTCPConnection -LocalPort %PORT% -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1; if ($p) { $pr = Get-Process -Id $p.OwningProcess -ErrorAction SilentlyContinue; Write-Host ('   Port %PORT% is already used by ' + $pr.ProcessName + ' (process ' + $p.OwningProcess + ').') } else { Write-Host '   Port %PORT% is free, so the bridge itself did not start.' }; Write-Host ('   Windows PowerShell version: ' + $PSVersionTable.PSVersion)"
echo.
echo   Starting it here in this window so you can see why.
echo   While this window stays open the bridge is running, so TDS Desk can be used.
echo   Red lines matter - send them if it keeps failing.
echo   (If nothing appears at all, antivirus may be blocking PowerShell scripts.)
echo   ----------------------------------------------------------
powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%DEST%\TDSBridge.ps1"
echo   ----------------------------------------------------------
echo.
pause
goto done

:remove
echo.
echo   Removing the Tally Bridge...
del "%STARTUP%\TDS Desk Tally Bridge.vbs" >nul 2>&1
taskkill /F /IM wscript.exe >nul 2>&1
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process -Filter \"Name = 'powershell.exe'\" | Where-Object { $_.CommandLine -like '*TDSBridge.ps1*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }" >nul 2>&1
echo   Done. The folder %DEST% can be deleted by hand if you wish.
echo.
pause

:done
exit /b
